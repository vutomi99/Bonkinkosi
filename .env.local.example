# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - these are your personal secrets.

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL) - required. Create the database and a login role:
#   CREATE DATABASE soc_db;
#   CREATE ROLE admin WITH LOGIN SUPERUSER PASSWORD 'admin';
# then run `npx prisma migrate deploy`.

DATABASE_URL="postgresql://admin:admin@localhost:5432/soc_db?schema=public"

# ---------------------------------------------------------------------------
# AI RISK SCORING (OpenRouter) - optional. Get a key at https://openrouter.ai/keys
# Each incoming event is scored 0-100 by an LLM (app/api/ingest/* and the
# simulator). If OPENROUTER_API_KEY is unset or the call fails, scoring falls
# back to the built-in rule-based formula, so the app still works offline.
# OPENROUTER_MODEL is any OpenRouter model id (e.g. a free one:
# meta-llama/llama-3.1-8b-instruct:free).

OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# EMAIL (Nodemailer) - used by app/api/alerts/[id]/report/route.js and the
# automatic severe-incident path inside app/api/simulate/tick/route.js and
# app/api/ingest/ssh-bruteforce/route.js
#
# Any SMTP provider works - a few common options:
#   - Gmail:      host=smtp.gmail.com port=587  (use a 16-char App Password, not your normal password)
#   - Outlook:    host=smtp.office365.com port=587
#   - Mailtrap:   host=sandbox.smtp.mailtrap.io port=2525  (great for testing - emails never leave a sandbox inbox)
#   - SendGrid:   host=smtp.sendgrid.net port=587  (user is "apikey", pass is your API key)
#
# If these are left unset, email-sending API routes do NOT crash - they log
# the email to the server console and mark it "simulated" so the app still
# works end-to-end without real credentials.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password

ALERT_EMAIL_TO=soc-team@yourcompany.com
ALERT_EMAIL_FROM="AI-Driven Integrated SOC <soc-alerts@yourcompany.com>"

# ---------------------------------------------------------------------------
# REAL ATTACK INGESTION - required only if you're running the agent on a
# victim VM (see README "Real attack ingestion").
#
# Pick any random string and put the SAME value here and in the agent's
# INGEST_KEY environment variable. Without this set, the ingestion route
# refuses every request rather than silently accepting unauthenticated writes.

INGEST_API_KEY=bonginkosi
