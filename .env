# Committed, non-secret settings. DATABASE_URL (PostgreSQL, includes the
# password) lives in .env.local, which is gitignored:
#   DATABASE_URL="postgresql://postgres:<password>@localhost:5432/soc_db?schema=public"

# Set to "true" to run the built-in simulator, which generates random fake
# events/alerts. Leave "false" when only real agent data should appear.
NEXT_PUBLIC_ENABLE_SIMULATION="false"
