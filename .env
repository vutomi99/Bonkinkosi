# Read by the Prisma CLI (migrate/generate/studio) and by the Next.js app.
# SQLite is used so the project runs with zero external setup - swap this
# for a real Postgres/MySQL URL in production (see README "Using a real
# database server" section).
DATABASE_URL="file:./prisma/dev.db"

# Set to "true" to run the built-in simulator, which generates random fake
# events/alerts. Leave "false" when only real agent data should appear.
NEXT_PUBLIC_ENABLE_SIMULATION="false"
