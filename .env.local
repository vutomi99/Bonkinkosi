# Local secrets - gitignored. See .env.local.example for all options.

# Must match INGEST_KEY in agent/run_agent2.sh on the victim VM.
INGEST_API_KEY=bonginkosi

# SMTP_* / ALERT_EMAIL_* not set: incident emails are logged to the server
# console as "simulated" instead of being sent. Fill them in from
# .env.local.example to send real email.

# PostgreSQL (installed locally). Login: admin / admin
# Use the same host/port/user/password to connect from DBeaver.
DATABASE_URL="postgresql://admin:admin@localhost:5432/soc_db?schema=public"

# AI risk scoring via OpenRouter (https://openrouter.ai/keys).
# If unset, scoring falls back to the rule-based formula.
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openai/gpt-4o-mini

# EMAIL (Gmail SMTP) - real incident alerts. App password stored WITHOUT spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=socsystemai@gmail.com
SMTP_PASS=uonnmkwbntmtrczw
ALERT_EMAIL_TO=vutomi99.ngobeni@gmail.com, dladlab477@gmail.com
ALERT_EMAIL_FROM="AI-Driven Integrated SOC <socsystemai@gmail.com>"
